<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.russian_language_training.MainController">
   <children>
      <ImageView fitHeight="700.0" fitWidth="1100.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../Images/blackfone_screen.png" />
         </image>
      </ImageView>
      <Label layoutX="297.0" layoutY="37.0" prefHeight="172.0" prefWidth="189.0" text="Тренажер" textFill="WHITE">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
      <Label layoutX="490.0" layoutY="64.0" prefHeight="120.0" prefWidth="200.0" text="Русского" textFill="#2200ff">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
      <Label layoutX="681.0" layoutY="80.0" prefHeight="89.0" prefWidth="123.0" text="Языка" textFill="RED">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
      <Button layoutX="372.0" layoutY="328.0" mnemonicParsing="false" onAction="#stressSceneRun" prefHeight="113.0" prefWidth="359.0" text="ИГРАТЬ">
         <font>
            <Font name="Cascadia Code Regular" size="65.0" />
         </font>
      </Button>
      <Button layoutX="47.0" layoutY="598.0" mnemonicParsing="false" onAction="#quit" prefHeight="59.0" prefWidth="189.0" text="Выход" textFill="RED">
         <font>
            <Font name="Cascadia Code Regular" size="38.0" />
         </font>
      </Button>
      <Button layoutX="733.0" layoutY="598.0" mnemonicParsing="false" onAction="#aboutApp" prefHeight="71.0" prefWidth="330.0" text="О приложении" textFill="#4400ff">
         <font>
            <Font name="Cascadia Code Regular" size="38.0" />
         </font>
      </Button>
      <Label layoutX="356.0" layoutY="133.0" prefHeight="103.0" prefWidth="390.0" text="Добро пожаловать!" textAlignment="JUSTIFY" textFill="#48ff00">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
