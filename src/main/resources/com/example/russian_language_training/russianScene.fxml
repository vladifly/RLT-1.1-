<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.russian_language_training.EmpSceneController">
   <children>
      <ImageView fitHeight="700.0" fitWidth="1100.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../Images/blackfone_screen.png" />
         </image>
      </ImageView>
      <Label layoutX="47.0" layoutY="62.0" prefHeight="172.0" prefWidth="806.0" text="Добро пожаловать в Тренажер" textFill="WHITE">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
      <Label layoutX="674.0" layoutY="90.0" prefHeight="120.0" prefWidth="200.0" text="Русского" textFill="#2200ff">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
      <Label layoutX="865.0" layoutY="105.0" prefHeight="89.0" prefWidth="189.0" text="Языка" textFill="RED">
         <font>
            <Font name="Cascadia Code Regular" size="39.0" />
         </font>
      </Label>
      <Button layoutX="371.0" layoutY="326.0" mnemonicParsing="false" onAction="#empSceneRun" prefHeight="113.0" prefWidth="359.0" text="ИГРАТЬ">
         <font>
            <Font name="Cascadia Code Regular" size="65.0" />
         </font>
      </Button>
      <Label alignment="CENTER" layoutX="375.0" layoutY="254.0" prefHeight="73.0" prefWidth="351.0" text="Игра на ударения" textFill="WHITE">
         <font>
            <Font name="Cascadia Code Regular" size="30.0" />
         </font>
      </Label>
      <Button layoutX="47.0" layoutY="598.0" mnemonicParsing="false" onAction="#quit" prefHeight="59.0" prefWidth="189.0" text="Выход" textFill="RED">
         <font>
            <Font name="Cascadia Code Regular" size="38.0" />
         </font>
      </Button>
      <Button layoutX="733.0" layoutY="598.0" mnemonicParsing="false" onAction="#aboutApp" prefHeight="71.0" prefWidth="330.0" text="О приложении" textFill="#4400ff">
         <font>
            <Font name="Cascadia Code Regular" size="38.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
